{
  "functions": {
    "api/execute.ts": {
      "maxDuration": 300
    },
    "api/publish.ts": {
      "maxDuration": 300
    },
    "api/adapt.ts": {
      "maxDuration": 120
    }
  },
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": { "pre": "circulo." } }],
      "destination": "/guia",
      "permanent": false
    },
    {
      "source": "/:path((?!guia$|crear$|operador$|api/circle-kit$|p/[0-9a-f-]{36}$|p/[0-9a-f-]{36}/toque$).+)",
      "has": [{ "type": "host", "value": { "pre": "circulo." } }],
      "destination": "/guia",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/:doc(guia|crear|operador)",
      "has": [{ "type": "host", "value": { "pre": "circulo." } }],
      "destination": "/api/circle-kit?doc=:doc"
    },
    {
      "source": "/p/:id([0-9a-f-]{36})/toque",
      "has": [{ "type": "host", "value": { "pre": "circulo." } }],
      "destination": "/api/circle-kit?p=:id&toque=1"
    },
    {
      "source": "/p/:id([0-9a-f-]{36})",
      "has": [{ "type": "host", "value": { "pre": "circulo." } }],
      "destination": "/api/circle-kit?p=:id"
    }
  ]
}
